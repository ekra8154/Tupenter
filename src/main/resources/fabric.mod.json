{
	"schemaVersion": 1,
	"id": "tupenter",
	"version": "${version}",
	"name": "Tupenter",
	"description": "Resend chat and commands on a keybind, and script them: && chaining, inline math, variables, loops, conditionals, and custom commands with real autocomplete — all client-side.",
	"authors": [
		"ekra8154"
	],
	"contact": {
		"homepage": "https://github.com/ekra8154/Tupenter",
		"sources": "https://github.com/ekra8154/Tupenter",
		"issues": "https://github.com/ekra8154/Tupenter/issues"
	},
	"license": "MIT",
	"icon": "assets/tupenter/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"net.tupenter.TupenterModClient"
		],
		"modmenu": [
			"net.tupenter.compat.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "tupenter.client.mixins.json",
			"environment": "client"
		}
	],
	"accessWidener": "tupenter.accesswidener",
	"depends": {
		"fabricloader": ">=0.18.2",
		"minecraft": "${minecraft_support_range}",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*",
		"cloth-config": "*"
	}
}