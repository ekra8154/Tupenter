{
	"schemaVersion": 1,
	"id": "tupenter",
	"version": "${version}",
	"name": "Tupenter",
	"description": "Resend chat and commands on a keybind, and script them: && chaining, inline math, variables, loops, conditionals, and custom commands with real autocomplete — all client-side.",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/tupenter/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"net.tupenter.TupenterModClient"
		],
		"modmenu": [
			"net.tupenter.compat.ModMenuIntegration"
		]
	},
	"mixins": [
		"tupenter.mixins.json",
		{
			"config": "tupenter.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.2",
		"minecraft": "~1.21.10",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*",
		"cloth-config": "*"
	}
}